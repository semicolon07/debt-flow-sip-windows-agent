<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
        <RootNamespace>DebtFlow.SipAgent.Host</RootNamespace>
        <AssemblyName>DebtFlow.SipAgent.Host</AssemblyName>
        <UseWindowsForms>true</UseWindowsForms>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
      <FrameworkReference Include="Microsoft.AspNetCore.App" />
      <PackageReference Include="NAudio" />
      <PackageReference Include="SIPSorcery" />
      <PackageReference Include="SIPSorceryMedia.Windows" />
      <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="src/DebtFlow.SipAgent.Application/DebtFlow.SipAgent.Application.csproj" />
      <ProjectReference Include="src/DebtFlow.SipAgent.Persistence/DebtFlow.SipAgent.Persistence.csproj" />
      <ProjectReference Include="src/DebtFlow.SipAgent.Protocol/DebtFlow.SipAgent.Protocol.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="src/**/*.cs" />
      <Compile Remove="tests/**/*.cs" />
    </ItemGroup>

    <ItemGroup>
      <None Update="agentsettings.example.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
